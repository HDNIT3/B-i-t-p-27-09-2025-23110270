type User {
    id: ID!
    fullname: String
    email: String
    password: String
    phone: String
    categories: [Category]   # nhiều-nhiều với Category
}

type Category {
    id: ID!
    name: String
    images: String
    users: [User]            # nhiều-nhiều với User
    products: [Product]      # 1-nhiều với Product
}

type Product {
    id: ID!
    title: String
    quantity: Int
    desc: String
    price: Float
    category: Category       # nhiều Product thuộc 1 Category
}

# -----------------------------
# Input để Mutation sử dụng
# -----------------------------
input UserInput {
    fullname: String
    email: String
    password: String
    phone: String
    categoryIds: [ID]        # liên kết nhiều Category
}

input CategoryInput {
    name: String
    images: String
    userIds: [ID]            # liên kết nhiều User
}

input ProductInput {
    title: String
    quantity: Int
    desc: String
    price: Float
    categoryId: ID           # mỗi Product thuộc 1 Category
}

# -----------------------------
# Query (tương ứng với @QueryMapping)
# -----------------------------
type Query {
    getAllUsers: [User]
    getUserById(id: ID!): User

    getAllCategories: [Category]
    getCategoryById(id: ID!): Category

    getAllProducts: [Product]
    getProductById(id: ID!): Product
    
    getAllProductsSortedByPrice: [Product]
}

# -----------------------------
# Mutation (tương ứng với @MutationMapping)
# -----------------------------
type Mutation {
    # User
    createUser(user: UserInput!): User
    updateUser(id: ID!, user: UserInput!): User
    deleteUser(id: ID!): Boolean

    # Category
    createCategory(category: CategoryInput!): Category
    updateCategory(id: ID!, category: CategoryInput!): Category
    deleteCategory(id: ID!): Boolean

    # Product
    createProduct(product: ProductInput!): Product
    updateProduct(id: ID!, product: ProductInput!): Product
    deleteProduct(id: ID!): Boolean
}
